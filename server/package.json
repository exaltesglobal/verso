{
  "name": "verso-server",
  "version": "0.1.0",
  "private": true,
  "description": "Verso accounts, entitlements and payments backend",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "razorpay:plans": "tsx src/razorpay-plans.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "invite:create": "tsx src/invite-create.ts",
    "credits:grant": "tsx src/credits-grant.ts",
    "credits:reset": "tsx src/credits-reset.ts",
    "tokens:cleanup": "tsx src/tokens-cleanup.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
