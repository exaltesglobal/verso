# Verso server configuration. Copy to server/.env for local dev; on Hostinger set these in hPanel.
# Every variable is optional in local dev. See docs/SETUP-KEYS.md for where each key comes from.

# ---------- Server ----------
# development | production | test. Production refuses to start without JWT_SECRET and entitlement keys.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
# Public base URL of this server, no trailing slash. Used in email links and the Google redirect URI.
PUBLIC_URL=http://localhost:8787
# Comma-separated origins allowed to call /v1 from a browser context (Tauri webview, Vite dev server).
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost
# Set to true behind Hostinger's proxy so client IPs (rate limits) and https detection are right.
TRUST_PROXY=false
# pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------- Database ----------
# sqlite (local dev, default, zero setup) or mysql (production).
DB_CLIENT=sqlite
SQLITE_FILE=./verso-dev.sqlite
# MySQL: either a URL...
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/verso
# ...or separate fields.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------- Tokens ----------
# HS256 secret for 15-minute access tokens. At least 32 chars. Generate: openssl rand -base64 48
# Leave empty in dev: a secret is generated into server/.dev-keys/.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Lifetime of the browser session cookie on the hosted pages.
SESSION_TTL_DAYS=30
# Ed25519 key pair (PEM) that signs offline entitlement tokens. Put the PEM on one line with \n for newlines.
# Leave empty in dev: a pair is generated into server/.dev-keys/.
ENTITLEMENT_PRIVATE_KEY=
ENTITLEMENT_PUBLIC_KEY=
# How many days the desktop app may trust an offline entitlement token without reaching the server.
OFFLINE_ENTITLEMENT_DAYS=7

# Requests per minute per IP on sign-in, sign-up, reset and token routes.
AUTH_RATE_LIMIT_PER_MINUTE=20

# ---------- Email (Resend) ----------
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=
# Must use a domain verified in Resend.
EMAIL_FROM=Verso <no-reply@example.com>

# ---------- Google sign-in ----------
# Without both, /auth/google returns 503 {"error":"google_not_configured"} and the button shows disabled.
# Authorized redirect URI in Google Cloud Console: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Payments (Razorpay) ----------
# Without key id, key secret and both plan ids, the pricing page says "Payments aren't set up yet".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you type when creating the webhook (Dashboard > Webhooks). URL: <PUBLIC_URL>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Plan ids (plan_...) from Dashboard > Subscriptions > Plans, or from `pnpm razorpay:plans`.
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
# Display only. Keep in sync with the Razorpay plan amounts.
PRICE_LABEL_PRO_MONTHLY=₹499 / month
PRICE_LABEL_PRO_YEARLY=₹4,999 / year

# ---------- AI credits ----------
# Every number the app shows comes from here (GET /v1/credits/pricing). See docs/SETUP-KEYS.md section 8.
# Top-ups need only RAZORPAY_KEY_ID/SECRET plus the payment.captured and order.paid webhook events.
CREDITS_FREE_MONTHLY=30
CREDITS_PRO_MONTHLY=1000
# Cost overrides as action=credits, e.g. auto_cut=5,dubbing=12. Actions: auto_cut, captions, speaker_reframe,
# dubbing, voiceover, background_removal, enhance_audio (per minute), hook_generator, caption_writer,
# watch_time_predictor (per run).
CREDITS_COSTS=
# Packs as credits:inrPaise[:usdCents], comma-separated. Drop the USD part to sell in rupees only.
CREDITS_PACKS=300:19900:299,1000:54900:799,3000:144900:1999
# false = only Pro users can buy packs.
CREDITS_TOPUP_FOR_FREE=true
# Credits the desktop app may spend offline before it has to sync.
CREDITS_OFFLINE_BUFFER=50
# In-process monthly refill check. 0 turns it off; then run `node dist/credits-reset.js` from cron.
CREDITS_RESET_INTERVAL_MINUTES=60

# ---------- Desktop app updates ----------
# Path to the latest.json that tauri-action attaches to each release. Served at
# /updates/{{target}}/{{arch}}/{{current_version}}. Missing file = "no update".
UPDATES_MANIFEST=./updates/latest.json

# ---------- Admin ----------
# Comma-separated emails that may open /admin (signed in, email confirmed). Empty = no admins.
# See docs/SETUP-KEYS.md section 9.
ADMIN_EMAILS=
