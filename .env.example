# Verso desktop app settings. Copy to .env.local (git-ignored) and fill in.
# Vite bakes these into the build, so set them before `pnpm tauri build`.

# Accounts API (the server in server/). Dev default: http://localhost:8787.
# Leave empty in a release build to ship without accounts: the app runs offline on the Free plan
# and account screens say "Sign-in isn't set up yet".
VITE_VERSO_API_URL=

# Closed beta: set to true to ask for an invite code (made with `pnpm invite:create` in server/) on first launch.
VITE_VERSO_BETA_GATE=false

# Not a Vite var: read by Cargo at build time (src-tauri/src/account.rs). The Ed25519 public key that signs
# offline entitlement tokens, as the JWK "x" value from <API>/.well-known/jwks.json. Required for release
# builds to honour Pro while offline. Export it in the shell (or CI) that runs `pnpm tauri build`.
# VERSO_ENTITLEMENT_PUBLIC_KEY=
